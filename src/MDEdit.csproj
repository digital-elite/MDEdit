<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Description>MD file editor and convertor</Description>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>MDEdit.snk</AssemblyOriginatorKeyFile>
    <ApplicationIcon>mdedit.ico</ApplicationIcon>
    <PackageIcon>mdedit_preview.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="mdedit.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\mdedit_preview.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
